# Railway Environment Variables Template
# Copy this to your Railway project settings

# === CRITICAL: MUST CHANGE THESE ===

# API Configuration
NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_MINIMUM_32_CHARS

# Database - Railway provides DATABASE_URL automatically
# But you can also set individual components:
DB_HOST=postgres-service-host-from-railway
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_DATABASE=railway

# Frontend URLs
CORS_ORIGIN=https://your-railway-domain.railway.app
FRONTEND_URL=https://your-railway-domain.railway.app

# === OPTIONAL: API Integrations ===

# OpenRouter (AI features)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-railway-domain.railway.app/auth/google/callback

# SendGrid (Email notifications)
# Get key from: https://sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_SENDER=noreply@yourdomain.com

# Email Reset Password
EMAIL_RESET_PASSWORD_URL=https://your-railway-domain.railway.app/reset-password
EMAIL_RESET_TEMPLATE_ID=

# Cloudinary (Image uploads)
# Get credentials from: https://cloudinary.com/
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_FOLDER=quizzy

# === OPTIONAL: Monitoring & Analytics ===

# Sentry (Error tracking)
# Get DSN from: https://sentry.io/
SENTRY_DSN=

# Google Analytics
VITE_GA_ID=
